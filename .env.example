# GEMINI_API_KEY
# Clave usada por el backend de LifeOS para las funciones de IA con Gemini.
# Si queda vacía, LifeOS utilizará los fallbacks locales disponibles.
# Nunca subas una clave real al repositorio.
GEMINI_API_KEY=""

# APP_URL
# URL base de LifeOS. En desarrollo local normalmente será http://localhost:3000.
# En producción configura la URL pública del despliegue correspondiente.
APP_URL="http://localhost:3000"
